# KhataVoice Configuration

# Server Port
PORT=3001

# Storage Driver: 'memory' (zero AWS creds, offline dev) or 'dynamodb' (AWS production)
STORAGE_DRIVER=memory

# AWS DynamoDB (Required only if STORAGE_DRIVER=dynamodb)
DYNAMODB_TABLE_NAME=KhataVoiceTable
AWS_REGION=us-east-1

# Amazon Bedrock (Optional: falls back to local NLP when unconfigured)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
