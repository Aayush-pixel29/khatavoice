{
  "name": "khata-voice-workspace",
  "version": "1.0.0",
  "description": "Production-quality voice-first MCP server for small-business financial operations",
  "private": true,
  "workspaces": [
    "server",
    "apps/web",
    "infra"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev": "concurrently -n \"server,web\" -c \"blue,green\" \"npm:dev:server\" \"npm:dev:web\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
